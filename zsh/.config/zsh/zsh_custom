# Copy current tmux pane (with colors) as HTML to clipboard
tmux2html() {
  if [ -n "$TMUX" ]; then
    tmux capture-pane -p -e | ansifilter --html | pbcopy
    echo "Screen HTML copied to clipboard"
  else
    echo "Not in a tmux session"
  fi
}

